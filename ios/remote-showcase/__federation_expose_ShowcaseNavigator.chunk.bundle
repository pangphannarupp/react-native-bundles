","service","application","loan api"]},{id:"CUSTOMER_SERVICE",title:"Customer (CIF) Service",category:"Services",subCategory:"SERVICES",tags:["service"],badge:"Customer API",description:"Query customer profiles, verify CBS synchronization, and search existing borrowers.",keywords:["customer","cif","service","dossier","cbs"]},{id:"DASHBOARD_SERVICE",title:"Dashboard Metrics Service",category:"Services",subCategory:"SERVICES",tags:["service"],badge:"Metrics API",description:"Retrieve real-time loan application counts, pending tasks, and portfolio summaries.",keywords:["dashboard","kpi","pipeline","approval","metrics"]}],v=e=>{var t,o=e.categoryId,r=e.onBack,b=(0,c.useNavigation)(),v=(0,c.useRoute)(),S=o||(null===(t=v.params)||void 0===t?void 0:t.categoryId)||"BUTTONS",T=(0,l.useRef)(null),w=(0,u.useShowcaseViewModel)(),j=w.state,I=w.actions,F=(0,x.useTheme)().theme,B=(0,g.useAutoScrollOnInputFocus)({scrollViewRef:T,extraMargin:36}),D=B.keyboardHeight,A=B.onScroll,k=l.default.useCallback(()=>{r?r():b.canGoBack()&&b.goBack()},[r,b]),P=(0,h.useBackNavigation)({onBack:k,enabled:!0}).panHandlers,R=f.find(e=>e.id===S);return(0,a.jsxs)(d.SafeAreaView,n._(i._({style:[C.safeArea,{backgroundColor:F.colors.background}]},P),{children:[(0,a.jsx)(p.ScreenHeader,{title:R?R.title:"LOS Component Showcase",onBack:k}),(0,a.jsx)(s.TouchableOpacity,{testID:"showcase-back-to-list",style:[C.backBanner,{backgroundColor:F.colors.card,borderBottomColor:F.colors.border}],onPress:k,activeOpacity:.7,children:(0,a.jsx)(s.Text,{style:[C.backBannerText,{color:F.colors.primary}],children:"← Back to All Components & Utils"})}),(0,a.jsx)(s.KeyboardAvoidingView,{style:C.keyboardAvoidingView,behavior:"ios"===s.Platform.OS?"padding":void 0,children:(0,a.jsx)(s.ScrollView,{ref:T,onScroll:A,scrollEventThrottle:16,contentContainerStyle:[C.scrollContent,D>0&&{paddingBottom:D+32}],nestedScrollEnabled:!0,keyboardShouldPersistTaps:"handled",children:(()=>{switch(S){case"GLOBAL_THEME":return(0,a.jsx)(y.ThemeCusto