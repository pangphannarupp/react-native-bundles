្ខខណ្ឌទាំងនេះ ព្រមទាំងលក្ខខណ្ឌជាក់លាក់បន្ថែមដែលអាចអនុវត្តចំពោះផលិតផល ឬសេវាកម្មនីមួយៗ។\\n\\nទិន្នន័យផ្ទាល់ខ្លួន កំណត់ត្រាប្រតិបត្តិការ និងឯកសារអត្តសញ្ញាណទាំងអស់ត្រូវបានរក្សាទុកដោយអនុលោមតាមបទប្បញ្ញត្តិស្តីពីការការពារទិន្នន័យនៃព្រះរាជាណាចក្រកម្ពុជា និងធនាគារជាតិនៃកម្ពុជា។"}},"auth":{"login":{"title":"សូមស្វាគមន៍មកវិញ","subtitle":"សូមចូលប្រើប្រាស់គណនីរបស់អ្នកដើម្បីចូលទៅកាន់ប្រព័ន្ធ LOS។","companyId":"លេខកូដក្រុមហ៊ុន","companyIdPlaceholder":"បញ្ចូលលេខកូដក្រុមហ៊ុន","userId":"ឈ្មោះគណនី ឬ អ៊ីមែល","userIdPlaceholder":"បញ្ចូលឈ្មោះគណនី ឬ អ៊ីមែល","password":"ពាក្យសម្ងាត់","passwordPlaceholder":"បញ្ចូលពាក្យសម្ងាត់របស់អ្នក","forgotPassword":"ភ្លេចពាក្យសម្ងាត់?","signInButton":"ចូលប្រើប្រាស់","validationCompanyRequired":"សូមបញ្ចូលលេខកូដក្រុមហ៊ុន","validationUserRequired":"សូមបញ្ចូលឈ្មោះគណនី ឬ អ៊ីមែល","validationPasswordRequired":"ពាក្យសម្ងាត់ត្រូវមានយ៉ាងហោចណាស់ ៦ តួអក្សរ"},"otp":{"title":"ការផ្ទៀងផ្ទាត់លេខកូដ OTP","subtitle":"សូមបញ្ចូលលេខកូដ ៦ ខ្ទង់ដែលបានផ្ញើទៅកាន់លេខទូរស័ព្ទ ឬអ៊ីមែលរបស់អ្នក។","resendCode":"ផ្ញើលេខកូដម្តងទៀត","resendIn":"ផ្ញើម្តងទៀតក្នុងរយៈពេល","verifyButton":"ផ្ទៀងផ្ទាត់ និងបន្ត","invalidCode":"សូមបញ្ចូលលេខកូដផ្ទៀងផ្ទាត់ ៦ ខ្ទង់ឱ្យបានត្រឹមត្រូវ។"},"biometric":{"title":"ចុះឈ្មោះស្កេនជីវមាត្រ","subtitle":"បើកដំណើរការការចូលប្រើប្រាស់រហ័ស និងមានសុវត្ថិភាព","description":"ប្រើស្នាមម្រាមដៃ ឬការស្កេនផ្ទៃមុខដើម្បីចូលប្រើប្រាស់ភ្លាមៗ ដោយមិនចាំបាច់វាយពាក្យសម្ងាត់រាល់ពេល។","enableButton":"បើកដំណើរការជីវមាត្រ","skipButton":"រំលងពេលនេះ","successMessage":"បានកំណត់ជីវមាត្រដោយជោគជ័យ។"}}}')},66424:function(e){"use strict";e.exports=JSON.parse('{"common":{"back":"뒤로","next":"다음","cancel":"취소","confirm":"확인","skip":"건너뛰기","processing":"처리 중...","error":"오류가 발생했습니다","success":"성공","agree":"동의합니다","exit":"종료","exitAppTitle":"앱 종료","exitAppMessage":"앱을 종료하시겠습니까?"},"launch":{"splash":{"version":"버전","checkingUpdates":"업데이트 확인 중...","downloadingUpdates":"업데이트 다운로드 중...","upToDate":"최신 버전입니다"},"language":{"welcomeTo":"환영합니다","appName":"여신 원장 시스템 (LOS)","selectLanguagePrompt":"사용하실 언어를 선택해 주세요","selectedNotice":"선택됨:","changeLaterTip":"설정에서 언제든지 언어를 변경할 수 있습니다."},"terms":{"title":"이용약관","sectionIntro":"I. 개요","introTitle":"I. 개요","agreeCheckboxLabel":"모든 이용약관에 동의합니다","agreeButton":"동의합니다","validationError":"진행하려면 이용약관에 동의해 주세요.","loadError":"이용약관을 불러오지 못했습니다.","termsContent":"본 일반 이용약관(이하 \\"약관\\")은 [마이크로파이낸스 기관 Plc.](이하 \\"기관\\")이 제공하는 금융 상품 및 서비스의 이용에 적용됩니다. 본 약관은 모든 고객(이하 \\"고객\\")이 기관의 금융 상품이나 서비스를 신청하거나 이용하기 전에 권리와 의무를 명확히 이해할 수 있도록 제공됩니다.\\n\\n고객이 서비스 신청서에 서명하거나 별도의 신청서 없이 서비스를 이용하는 경우, 본 약관 및 해당 서비스에 적용되는 추가 조건을 읽고 이해하였으며 이에 동의한 것으로 간주됩니다.\\n\\n모든 개인정보, 금융 거래 기록 및 신분 확인 문서는 캄보디아 관련 개인정보 보호 규정 및 캄보디아 국립은행(NBC)의 규정을 엄격히 준수하여 안전하게 보관됩니다."}},"auth":{"login":{"title":"다시 오신 것을 환영합니다","subtitle":"LOS 대시보드에 접속하려면 로그인해 주세요.","companyId":"회사 코드","companyIdPlaceholder":"회사 코드를 입력하세요","userId":"사용자 ID","userIdPlaceholder":"사용자 ID 또는 이메일을 입력하세요","password":"비밀번호","passwordPlaceholder":"비밀번호를 입력하세요","forgotPassword":"비밀번호를 잊으셨나요?","signInButton":"로그인","validationCompanyRequired":"회사 코드를 입력해 주세요","validationUserRequired":"사용자 ID를 입력해 주세요","validationPasswordRequired":"비밀번호는 최소 6자 이상이어야 합니다"},"otp":{"title":"OTP 인증","subtitle":"등록된 휴대폰 번호 또는 이메일로 전송된 6자리 번호를 입력해 주세요.","resendCode":"인증번호 재전송","resendIn":"재전송 가능 시간:","verifyButton":"인증 및 계속","invalidCode":"올바른 6자리 인증번호를 입력해 주세요."},"biometric":{"title":"생체 인증 등록","subtitle":"빠르고 안전한 생체 인증 활성화","description":"지문 또는 얼굴 인식을 사용하여 매번 비밀번호를 입력할 필요 없이 간편하게 로그인하세요.","enableButton":"생체 인증 사용","skipButton":"다음에 하기","successMessage":"생체 인증이 성공적으로 설정되었습니다."}}}')},57876:function(e){"use strict";e.exports=JSON.parse('{"common":{"back":"返回","next":"下一步","cancel":"取消","confirm":"确认","skip":"跳过","processing":"处理中...","error":"发生错误","success":"成功","agree":"我同意","exit":"退出","exitAppTitle":"退出应用","exitAppMessage":"您确定要退出应用程序吗？"},"launch":{"splash":{"version":"版本","checkingUpdates":"正在检查更新...","downloadingUpdates":"正在下载更新...","upToDate":"已是最新版本"},"language":{"welcomeTo":"欢迎使用","appName":"信贷发起审批系统 (LOS)","selectLanguagePrompt":"请选择您的语言","selectedNotice":"已选择：","changeLaterTip":"您稍后可以在系统设置中随时更改语言。"},"terms":{"title":"条款与条件","sectionIntro":"I. 简介","introTitle":"I. 简介","agreeCheckboxLabel":"同意所有条款与条件","agreeButton":"我同意","validationError":"请先同意条款与条件以继续。","loadError":"无法加载条款与条件。","termsContent":"本通用条款与条件（以下简称“条款”）适用于使用[小额信贷机构股份有限公司]（以下简称“本机构”）提供的产品和服务。提供这些条款旨在帮助所有客户（“客户”）在申请或使用本机构的任何产品或服务之前充分了解其权利和义务。\\n\\n客户签署任何产品或服务申请表，或在没有申请表的情况下使用服务，即视为客户已阅读、理解并接受本条款以及适用于各项产品或服务的任何补充具体条款。\\n\\n所有个人数据、交易记录和身份证明文件均严格按照柬埔寨现行数据保护法规和柬埔寨国家银行的规定妥善存储和保密。"}},"auth":{"login":{"title":"欢迎回来","subtitle":"请输入您的凭据以访问 LOS 控制面板。","companyId":"公司代码","companyIdPlaceholder":"请输入公司代码","userId":"用户 ID / 邮箱","userIdPlaceholder":"请输入用户 ID 或邮箱","password":"密码","passwordPlaceholder":"请输入密码","forgotPassword":"忘记密码？","signInButton":"登录","validationCompanyRequired":"公司代码不能为空","validationUserRequired":"用户 ID 不能为空","validationPasswordRequired":"密码长度至少需为 6 个字符"},"otp":{"title":"OTP 验证码","subtitle":"请输入发送至您预留手机或电子邮箱的 6 位数字验证码。","resendCode":"重新发送验证码","resendIn":"重新发送倒计时：","verifyButton":"验证并继续","invalidCode":"请输入有效的 6 位验证码。"},"biometric":{"title":"生物识别认证注册","subtitle":"开启快速安全的生物识别访问","description":"使用指纹或面部识别即时登录，无需每次重复输入密码。","enableButton":"启用生物识别","skipButton":"暂不设置","successMessage":"生物识别设置成功。"}}}')}}]);//# sourceMappingURL=packages_core_i18n_ts-packages_core_theme_index_ts-packages_ui-components_modals_index_ts.chunk.bundle.map?platform=android