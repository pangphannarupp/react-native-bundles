ant="lotte-brand-red"\n  title="Sign in"\n  brandLogoText="LOTTE FINANCE"\n  welcomeText="Welcome to,"\n  heroTitle="LOTTE FINANCE Digital Finance"\n  expandedHeight={220}\n  collapsedHeight={60}\n  scrollY={scrollY}\n  onBackPress={() => navigation.goBack()}\n/>\n\n// 2. Multi-Style Variations Available:\n// variant="lotte-brand-red"  -> Authentic Lotte red with curved decorative wave circles\n// variant="curved-sheet"     -> Header with bottom rounded sheet lip for sliding card flows\n// variant="navy-gradient"    -> Midnight sapphire blue gradient for wealth & credit cards\n// variant="emerald-wealth"   -> Emerald green gradient for microfinance & savings\n// variant="clean-minimal"    -> Minimalist light theme with hairline divider\n// variant="dark-elevation"   -> Dark slate theme with subtle elevation\n\n// 3. Connect to Animated.ScrollView with pinned header overlay:\n<View style={{ flex: 1, position: \'relative\' }}>\n  <Animated.ScrollView\n    contentContainerStyle={{ paddingTop: 220 }}\n    onScroll={Animated.event(\n      [{ nativeEvent: { contentOffset: { y: scrollY } } }],\n      { useNativeDriver: false }\n    )}\n    scrollEventThrottle={16}\n  >\n    {/* Screen Content */}\n  </Animated.ScrollView>\n\n  <View style={{ position: \'absolute\', top: 0, left: 0, right: 0, zIndex: 10 }}>\n    <AndroidSliverAppBar scrollY={scrollY} ... />\n  </View>\n</View>'}),(0,o.jsxs)(u.AppCard,{children:[(0,o.jsx)(l.Text,{style:p.sectionTitle,children:"Interactive Sliver App Bar Styles & Sandbox"}),(0,o.jsx)(l.Text,{style:p.helperText,children:"Choose a style variant below to test the header. Then scroll the device frame to witness how the large hero header, curved wave background, brand logo, and titles smoothly collapse into a compact top app bar without clipping."}),(0,o.jsx)(l.View,{style:{marginBottom:12},children:(0,o.jsx)(u.AppButton,{title:"Open Full-Screen Demo (Status Bar)",onPress:()=>e.navigate("SliverFullScreenDemo",{variant:n}),testID:"open-fullscreen-s