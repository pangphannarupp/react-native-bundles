u17b9\u17c7\u179f\u17d2\u1790\u17b6\u1793\u1798\u17b8\u1780\u17d2\u179a\u17bc\u17a0\u17b7\u179a\u1789\u17d2\u1789\u179c\u178f\u17d2\u1790\u17bb \u1797\u17b8\u17a2\u17b7\u179b\u179f\u17ca\u17b8] (\u17a0\u17c5\u1780\u17b6\u178f\u17cb\u1790\u17b6 \"\u1782\u17d2\u179a\u17b9\u17c7\u179f\u17d2\u1790\u17b6\u1793\")\u17d4 \u179b\u1780\u17d2\u1781\u1781\u178e\u17d2\u178c\u1791\u17b6\u17c6\u1784\u1793\u17c1\u17c7\u178f\u17d2\u179a\u17bc\u179c\u1794\u17b6\u1793\u1795\u17d2\u178f\u179b\u17cb\u1787\u17bc\u1793\u178a\u17be\u1798\u17d2\u1794\u17b8\u1787\u17bd\u1799\u17a2\u178f\u17b7\u1790\u17b7\u1787\u1793\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb (\"\u17a2\u178f\u17b7\u1790\u17b7\u1787\u1793\") \u1799\u179b\u17cb\u1785\u17d2\u1794\u17b6\u179f\u17cb\u1796\u17b8\u179f\u17b7\u1791\u17d2\u1792\u17b7 \u1793\u17b7\u1784\u1780\u17b6\u178f\u1796\u17d2\u179c\u1780\u17b7\u1785\u17d2\u1785\u179a\u1794\u179f\u17cb\u1796\u17bd\u1780\u1782\u17c1 \u1798\u17bb\u1793\u1796\u17c1\u179b\u178a\u17b6\u1780\u17cb\u1796\u17b6\u1780\u17d2\u1799\u179f\u17d2\u1793\u17be\u179f\u17bb\u17c6 \u17ac\u1794\u17d2\u179a\u17be\u1794\u17d2\u179a\u17b6\u179f\u17cb\u1795\u179b\u17b7\u178f\u1795\u179b \u17ac\u179f\u17c1\u179c\u17b6\u1780\u1798\u17d2\u1798\u178e\u17b6\u1798\u17bd\u1799\u179a\u1794\u179f\u17cb\u1782\u17d2\u179a\u17b9\u17c7\u179f\u17d2\u1790\u17b6\u1793\u17d4\n\n\u178f\u17b6\u1798\u179a\u1799\u17c8\u1780\u17b6\u179a\u1785\u17bb\u17c7\u17a0\u178f\u17d2\u1790\u179b\u17c1\u1781\u17b6\u179b\u17be\u1791\u1798\u17d2\u179a\u1784\u17cb\u1796\u17b6\u1780\u17d2\u1799\u179f\u17bb\u17c6 \u17ac\u1780\u17b6\u179a\u1794\u17d2\u179a\u17be\u1794\u17d2\u179a\u17b6\u179f\u17cb\u179f\u17c1\u179c\u17b6\u1780\u1798\u17d2\u1798\u178a\u17c4\u1799\u1782\u17d2\u1798\u17b6\u1793\u1791\u1798\u17d2\u179a\u1784\u17cb\u1796\u17b6\u1780\u17d2\u1799\u179f\u17bb\u17c6 \u17a2\u178f\u17b7\u1790\u17b7\u1787\u1793\u178f\u17d2\u179a\u17bc\u179c\u1794\u17b6\u1793\u1785\u17b6\u178f\u17cb\u1791\u17bb\u1780\u1790\u17b6\u1794\u17b6\u1793\u17a2\u17b6\u1793 \u1799\u179b\u17cb \u1793\u17b7\u1784\u1791\u1791\u17bd\u179b\u1799\u1780\u179b\u1780\u17d2\u1781\u1781\u178e\u17d2\u178c\u1791\u17b6\u17c6\u1784\u1793\u17c1\u17c7 \u1796\u17d2\u179a\u1798\u1791\u17b6\u17c6\u1784\u179b\u1780\u17d2\u1781\u1781\u178e\u17d2\u178c\u1787\u17b6\u1780\u17cb\u179b\u17b6\u1780\u17cb\u1794\u1793\u17d2\u1790\u17c2\u1798\u178a\u17c2\u179b\u17a2\u17b6\u1785\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f\u1785\u17c6\u1796\u17c4\u17c7\u1795\u179b\u17b7\u178f\u1795\u179b \u17ac\u179f\u17c1\u179c\u17b6\u1780\u1798\u17d2\u1798\u1793\u17b8\u1798\u17bd\u1799\u17d7\u17d4\n\n\u1791\u17b7\u1793\u17d2\u1793\u1793\u17d0\u1799\u1795\u17d2\u1791\u17b6\u179b\u17cb\u1781\u17d2\u179b\u17bd\u1793 \u1780\u17c6\u178e\u178f\u17cb\u178f\u17d2\u179a\u17b6\u1794\u17d2\u179a\u178f\u17b7\u1794\u178f\u17d2\u178f\u17b7\u1780\u17b6\u179a \u1793\u17b7\u1784\u17af\u1780\u179f\u17b6\u179a\u17a2\u178f\u17d2\u178f\u179f\u1789\u17d2\u1789\u17b6\u178e\u1791\u17b6\u17c6\u1784\u17a2\u179f\u17cb\u178f\u17d2\u179a\u17bc\u179c\u1794\u17b6\u1793\u179a\u1780\u17d2\u179f\u17b6\u1791\u17bb\u1780\u178a\u17c4\u1799\u17a2\u1793\u17bb\u179b\u17c4\u1798\u178f\u17b6\u1798\u1794\u1791\u1794\u17d2\u1794\u1789\u17d2\u1789\u178f\u17d2\u178f\u17b7\u179f\u17d2\u178f\u17b8\u1796\u17b8\u1780\u17b6\u179a\u1780\u17b6\u179a\u1796\u17b6\u179a\u1791\u17b7\u1793\u17d2\u1793\u1793\u17d0\u1799\u1793\u17c3\u1796\u17d2\u179a\u17c7\u179a\u17b6\u1787\u17b6\u178e\u17b6\u1785\u1780\u17d2\u179a\u1780\u1798\u17d2\u1796\u17bb\u1787\u17b6 \u1793\u17b7\u1784\u1792\u1793\u17b6\u1782\u17b6\u179a\u1787\u17b6\u178f\u17b7\u1793\u17c3\u1780\u1798\u17d2\u1796\u17bb\u1787\u17b6\u17d4"}},auth:{login:{title:"\u179f\u17bc\u1798\u179f\u17d2\u179c\u17b6\u1782\u1798\u1793\u17cd\u1798\u1780\u179c\u17b7\u1789",subtitle:"\u179f\u17bc\u1798\u1785\u17bc\u179b\u1794\u17d2\u179a\u17be\u1794\u17d2\u179a\u17b6\u179f\u17cb\u1782\u178e\u1793\u17b8\u179a\u1794\u179f\u17cb\u17a2\u17d2\u1793\u1780\u178a\u17be\u1798\u17d2\u1794\u17b8\u1785\u17bc\