OTP, contacts picker, and Khmer lunar calendar."},{id:"BIZMOB_SENSORS_MEDIA",title:"bizMOB Location, Audio & Native Viewers (M21-M22)",category:"Services",badge:"Sensors",description:"High-accuracy GPS location, Khmer speech-to-text, sound payment chime, PDF/image native previewers, and activity tracking."},{id:"BIZMOB_SYSTEM_SETTINGS",title:"bizMOB Status Bar, Clipboard & Settings (M21-M22)",category:"Services",badge:"System",description:"Dynamic status bar height & style, clipboard get/set, secure PIN keypad overlay, and app settings."},{id:"BIZMOB_SQLITE_STORAGE",title:"bizMOB SQLite & Offline Data Mode (M21-M22)",category:"Services",badge:"SQLite & Cache",description:"Encrypted SQLite database, FStorage, PStorage, and complete offline branch/events list and detail navigation."},{id:"BIZMOB_MEDIA_TOOLS",title:"bizMOB Image Tools, Signature & OCR (M21-M22)",category:"Services",badge:"Media Processing",description:"Gallery media picker, crop, resize, rotate, digital signature pad, and ID card OCR upload."},{id:"BIZMOB_ENTERPRISE_SECURITY",title:"bizMOB Firebase, IAM & FIDO (M21-M22)",category:"Services",badge:"Enterprise",description:"Firebase Analytics, Crashlytics, Remote Config, bank IAM SSO, and WebAuthn FIDO authentication."},{id:"BUTTONS",title:"Buttons & Action Bars",category:"Components",badge:"AppButton, FAB",description:"Primary, secondary, outline, danger buttons, loading states, and floating action button."},{id:"INPUTS",title:"Form Inputs & Validation",category:"Components",badge:"Form, OTP",description:"Text inputs, currency amount, OTP pin code, number steppers, and reactive validation."},{id:"SELECTION",title:"Selection & Pickers",category:"Components",badge:"Radio, Chips, Sliders",description:"Checkboxes, toggle switches, radio card groups, select chip filters, and range sliders."},{id:"DATE_TIME_PICKERS",title:"Date & Time Selection Fields",category:"Components",badge:"Calendar & Wheel Pickers",description:"Interactive DatePickerField (Single & Date Range with Presets), TimePickerField (Wheel & Digital Dial), and Month/Quarter pickers with BottomSheet & Alert dialog presentation modes."},{id:"FEEDBACK",title:"Feedback, Badges & Step Indicators",category:"Components",badge:"Status, Alert, Steps",description:"Status badges, feedback banners, step progress wizards, and transaction result screens."},{id:"ACCORDION_PROGRESS_EMPTY",title:"Accordions, Progress & Empty States",category:"Components",badge:"Cards & Skeleton",description:"Collapsible accordion menus, linear progress bars, skeleton loaders, and empty states."},{id:"DOCUMENT_UPLOAD",title:"Document Upload & Camera Guide",category:"Components",badge:"Upload & KYC",description:"Document upload cards, file attachment triggers, and national ID camera framing overlay."},{id:"MODALS",title:"Popups, Bottom Sheets & Modals",category:"Components",badge:"Dialogs & Menus",description:"Universal bottom sheets, pull-down draggable handles, backdrop blur options, action sheets, image viewer dialog, and comment logs."},{id:"DATA_TABLE",title:"Data Table with Pagination (Dossiers)",category:"Components",badge:"Table, Pagination",description:"Enterprise data grid with clickable dossier links, customer names, source channels, and active pagination controls (1-8/100 Kết quả)."},{id:"PDF_VIEWER",title:"PDF Document Viewer (Terms & Conditions)",category:"Components",badge:"Legal & PDF",description:"Document viewer featuring a dark action toolbar (Page indicator, Zoom, Download, Print, Share), legal paper sheets, and pagination controls."},{id:"HORIZONTAL_CARD_LIST",title:"Horizontal Card List (Recommended Cards)",category:"Components",badge:"Card Carousel",description:'Horizontal credit card carousel with section navigation header ("RECOMMENDED CARD 〉"), credit card graphics, badges, and dual-line metadata.'},{id:"TIMELINE_VARIANTS",title:"Timeline Variants & History Timeline",category:"Components",badge:"Timelines & Guides",description:"Multiple enterprise timelines: Stepper Badge (Card Issuance Guide), Company History (Speech-bubble date pill & milestone cards), Underwriting Status Nodes, and Compact Activity Log."},{id:"RANGE_SLIDER",title:"Range Slider (Amount & Tenure)",category:"Components",badge:"Interactive Slider",description:"Smooth touch and drag range slider for loan principal request and repayment tenure boundaries."},{id:"ONBOARDING_SLIDER",title:"Onboarding Slider",category:"Components",badge:"Onboarding Carousel",description:"Horizontal paged onboarding slider with illustrations, badges, interactive pagination dots, Skip action, and Next/Get Started CTA."},{id:"PERIOD_PICKER",title:"Period Picker (Month / Quarter / Semester / Year)",category:"Components",badge:"Single & Range",description:"Unified period picker supporting Month, Quarter, Semester, and Year selection in Single or Range (From ~ To) mode with multi-language support."},{id:"PARALLAX_SCROLL_VIEW",title:"Parallax Scroll View",category:"Components",badge:"Animated Scroll",description:"Smooth parallax hero header with overscroll stretch, depth translation, and collapsing sticky top bar."},{id:"ANIMATED_BADGE",title:"Animated Badge",category:"Components",badge:"Pop, Pulse, Bounce",description:"Animated wrapper around AppBadge supporting pop, pulse, bounce, shake animations and smooth visibility transitions."},{id:"CAROUSEL",title:"Carousel",category:"Components",badge:"Auto-Play & Arrows",description:"Generic horizontal paging carousel with auto-play, looping, interactive pagination dots, and optional navigation arrows."},{id:"COLOR_PICKER",title:"Color Picker",category:"Components",badge:"Swatches & Hex",description:"Interactive color swatch grid with active checkmark indicator, live preview, and validated custom #RRGGBB hex input."},{id:"CONTEXT_MENU",title:"Context Menu",category:"Components",badge:"Popover & Actions",description:"Anchored popover context menu supporting tap or long-press triggers, icons, dividers, disabled items, and destructive actions."},{id:"IMAGE_VIEWER",title:"Image Viewer",category:"Components",badge:"Blur, Zoom & Swipe",description:"Full-screen image viewer over a blurred backdrop with zoom in/out controls, swipe navigation, counter, and captions."},{id:"ENTERPRISE_COMPONENTS",title:"Enterprise Banking Layouts",category:"Components",badge:"Chips, Stepper, Specs",description:"Promotional action cards, category select chips, number stepper controls, servicing branch bottom sheet picker, and loan summary key-value lists."},{id:"NAVIGATION_PROFILE_TIMELINE",title:"Navigation, Profile & Header Controls",category:"Components",badge:"Drawer & Header",description:"Tab navigation bars, sliding menu drawers, circular profile avatars with edit modal, action headers, and floating action buttons."},{id:"SLIVER_APP_BAR",title:"Android & iOS Sliver App Bar",category:"Components",badge:"Collapsible Header",description:"Fluid collapsible header with smooth background interpolation, flexible action buttons, and pinned title banner."},{id:"ADVANCED_LOS_COMPONENTS",title:"Advanced Banking & Security Fields",category:"Components",badge:"Passcode, QR, Cam Guide",description:"Reactive 4-stage password strength validator, OTP countdown with auto-resend, customizable currency inputs, QR code generator/scanner dialog, KYC document upload boxes, and camera viewfinder guides."},{id:"DIGITAL_CHANNELS",title:"Digital Channels & Customer Support (M17-M20)",category:"Components",badge:"Support & Help",description:"Interactive Contact Support cards, quick-dial hotline actions, official email launcher, branch locator, and customer service modal dialogs."},{id:"LOAN_CALCULATOR",title:"Loan Amortization Calculator",category:"Utilities",badge:"Financial Math",description:"Equal installment formula, monthly principal breakdown, and interest calculations."},{id:"FORMAT_ID_UTILS",title:"Formatters & ID Card Validation",category:"Utilities",badge:"Formatting & ID",description:"Currency, phone masking, date formatters, and Cambodian National ID validation logic."},{id:"BANKING_UTILS",title:"Banking Domain Utilities & DSCR",category:"Utilities",badge:"Core Calculations",description:"Debt Service Coverage Ratio (DSCR), Loan-to-Value (LTV), Repayment Schedule Generator, and CIC Credit Risk Score evaluators."},{id:"AUTO_SAVE_DRAFT",title:"Auto-Save Draft Utility",category:"Utilities",badge:"Draft & Resume",description:"Debounced auto-save for multi-step loan forms with Continue/Cancel resume prompt and automatic clear on submit."},{id:"ORIGINATION_SERVICE",title:"Loan Origination Service",category:"Services",badge:"Application API",description:"Create, search, filter, and draft loan applications with in-memory persistence."},{id:"CUSTOMER_SERVICE",title:"Customer (CIF) Service",category:"Services",badge:"Customer API",description:"Query customer profiles, verify CBS synchronization, and search existing borrowers."},{id:"DASHBOARD_SERVICE",title:"Dashboard Metrics Service",category:"Services",badge:"Metrics API",description:"Retrieve real-time loan application counts, pending tasks, and portfolio summaries."}],y=e=>{var t,r=e.categoryId,n=e.onBack,y=(0,c.useNavigation)(),_=(0,c.useRoute)(),S=r||(null===(t=_.params)||void 0===t?void 0:t.categoryId)||"BUTTONS",x=(0,l.useRef)(null),C=(0,d.useShowcaseViewModel)(),w=C.state,T=C.actions,P=(0,p.useAutoScrollOnInputFocus)({scrollViewRef:x,extraMargin:36}),E=P.keyboardHeight,I=P.onScroll,k=l.default.useCallback(()=>{n?n():y.canGoBack()&&y.goBack()},[n,y]),j=(0,f.useBackNavigation)({onBack:k,enabled:!0}).panHandlers,O=v.find(e=>e.id===S);return(0,a.jsxs)(u.SafeAreaView,o._(i._({style:b.safeArea},j),{children:[(0,a.jsx)(h.ScreenHeader,{title:O?O.title:"LOS Component Showcase",onBackPress:k}),(0,a.jsx)(s.TouchableOpacity,{testID:"showcase-back-to-list",style:b.backBanner,onPress:k,activeOpacity:.7,children:(0,a.jsx)(s.Text,{style:b.backBannerText,children:"← Back to All Components & Utils"})}),(0,a.jsx)(s.KeyboardAvoidingView,{style:b.keyboardAvoidingView,behavior