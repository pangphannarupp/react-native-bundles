__d(function(e,t,o,n,a,i,s){a.exports={common:{back:"\ub4a4\ub85c",next:"\ub2e4\uc74c",cancel:"\ucde8\uc18c",confirm:"\ud655\uc778",skip:"\uac74\ub108\ub6f0\uae30",processing:"\ucc98\ub9ac \uc911...",error:"\uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4",success:"\uc131\uacf5",agree:"\ub3d9\uc758\ud569\ub2c8\ub2e4",exit:"\uc885\ub8cc",exitAppTitle:"\uc571 \uc885\ub8cc",exitAppMessage:"\uc571\uc744 \uc885\ub8cc\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"},launch:{splash:{version:"\ubc84\uc804",checkingUpdates:"\uc5c5\ub370\uc774\ud2b8 \ud655\uc778 \uc911...",downloadingUpdates:"\uc5c5\ub370\uc774\ud2b8 \ub2e4\uc6b4\ub85c\ub4dc \uc911...",upToDate:"\ucd5c\uc2e0 \ubc84\uc804\uc785\ub2c8\ub2e4"},language:{welcomeTo:"\ud658\uc601\ud569\ub2c8\ub2e4",appName:"\uc5ec\uc2e0 \uc6d0\uc7a5 \uc2dc\uc2a4\ud15c (LOS)",selectLanguagePrompt:"\uc0ac\uc6a9\ud558\uc2e4 \uc5b8\uc5b4\ub97c \uc120\ud0dd\ud574 \uc8fc\uc138\uc694",selectedNotice:"\uc120\ud0dd\ub428:",changeLaterTip:"\uc124\uc815\uc5d0\uc11c \uc5b8\uc81c\ub4e0\uc9c0 \uc5b8\uc5b4\ub97c \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."},terms:{title:"\uc774\uc6a9\uc57d\uad00",sectionIntro:"I. \uac1c\uc694",introTitle:"I. \uac1c\uc694",agreeCheckboxLabel:"\ubaa8\ub4e0 \uc774\uc6a9\uc57d\uad00\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4",agreeButton:"\ub3d9\uc758\ud569\ub2c8\ub2e4",validationError:"\uc9c4\ud589\ud558\ub824\uba74 \uc774\uc6a9\uc57d\uad00\uc5d0 \ub3d9\uc758\ud574 \uc8fc\uc138\uc694.",loadError:"\uc774\uc6a9\uc57d\uad00\uc744 \ubd88\ub7ec\uc624\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4.",termsContent:"\ubcf8 \uc77c\ubc18 \uc774\uc6a9\uc57d\uad00(\uc774\ud558 \"\uc57d\uad00\")\uc740 [\ub9c8\uc774\ud06c\ub85c\ud30c\uc774\ub0b8\uc2a4 \uae30\uad00 Plc.](\uc774\ud558 \"\uae30\uad00\")\uc774 \uc81c\uacf5\ud558\ub294 \uae08\uc735 \uc0c1\ud488 \ubc0f \uc11c\ube44\uc2a4\uc758 \uc774\uc6a9\uc5d0 \uc801\uc6a9\ub429\ub2c8\ub2e4. \ubcf8 \uc57d\uad00\uc740 \ubaa8\ub4e0 \uace0\uac1d(\uc774\ud558 \"\uace0\uac1d\")\uc774 \uae30\uad00\uc7