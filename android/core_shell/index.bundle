e={24} color="#FFFFFF" />}\n  onPress={() => handleAdd()}\n/>\n\n// 2. Gradient Button with Direction & Custom Colors\n<AppButton\n  title="Apply for Loan"\n  variant="gradient"\n  gradientColors={[\'#E7252B\', \'#991B1B\']}\n  gradientDirection="horizontal"\n  borderRadius={12}\n  onPress={() => handleApply()}\n/>\n\n// 3. Custom Border Radius & Shape (Pill, Rounded, Sharp)\n<AppButton\n  title="Custom Radius"\n  borderRadius={16}\n  variant="primary"\n  onPress={() => handleAction()}\n/>\n\n// 4. Biometric Pill Button with SVG Icon (AU-002 style)\n<AppButton\n  title="Sign in with Face ID"\n  variant="outline"\n  rounded\n  icon={<FaceIdIcon size={24} color="#E7252B" />}\n  onPress={() => handleBiometricLogin()}\n/>\n\n// 5. Button with Trailing/Right Icon\n<AppButton\n  title="Search Records"\n  variant="secondary"\n  iconPosition="right"\n  icon={<SearchIconSvg size={18} color="#FFFFFF" />}\n  onPress={() => handleSearch()}\n/>',INPUTS:'import { AmountInput, OtpInput } from \'@/shared/components\';\n\n// Currency Amount Input\n<AmountInput\n  label="Loan Amount"\n  value={loanAmount}\n  onChangeAmount={(numericVal) => setLoanAmount(numericVal)}\n  min={500}\n  max={50000}\n  currency="USD"\n/>\n\n// 6-digit OTP verification box\n<OtpInput\n  length={6}\n  value={otpCode}\n  onChangeOtp={(code) => setOtpCode(code)}\n/>',SELECTION:"import { RadioGroup, Checkbox, ToggleSwitch, SegmentedControl, AppRangeSlider } from '@/shared/components';\n\n// Interactive Range Slider\n<AppRangeSlider\n  label=\"Loan Principal Amount\"\n  value={amount}\n  min={5000}\n  max={100000}\n  step={1000}\n  unit=\"USD\"\n  onChange={(val) => setAmount(val)}\n/>\n\n<SegmentedControl\n  items={[{ label: 'Cash', value: 'CASH' }, { label: 'Car', value: 'CAR' }]}\n  selectedValue={scheme}\n  onSelect={(val) => setScheme(val)}\n/>\n\n<RadioGroup\n  label=\"Select Tenure\"\n  layout=\"row\"\n  options={[{ label: '12M', value: 12 }, { label: '24M', value: 24 }]}\n  selectedValue={tenure}\n  onSelect={(val) => setTenure(val)}\n/>\n\n<ToggleSwitch\n  label=\"Biometrics\"\n  value={biometricEnabled}\n  onValueChange={setBiometricEnabled}\n/>\n\n<Checkbox\n  label=\"Agree to terms\"\n  checked={agreed}\n  onToggle={setAgreed}\n/>",FEEDBACK:"import { StepIndicator, StatusBadge, ProcessCheckList } from '@mfe/ui-components';\n\n// 1. Process Check List (Customer Information Screening)\n<ProcessCheckList\n  title=\"Checking customer information\"\n  description=\"The system is checking the customer information.\"\n  items={[\n    { id: '1', label: 'Automatic screening result', status: 'completed', resultText: 'Passed' },\n    { id: '2', label: 'Existing application check result', status: 'completed' },\n    { id: '3', label: 'Sending loan application for preliminary screening', status: 'in_progress' }\n  ]}\n  animated={true}\n/>\n\n// 2. Multi-step progress bar\n<StepIndicator\n  steps={[\n    { key: 'scheme', label: 'Scheme' },\n    { key: 'ekyc', label: 'eKYC' },\n    { key: 'submit', label: 'Submit' }\n  ]}\n  currentStepIndex={1}\n/>\n\n// 3. Color-coded status badge\n<StatusBadge label=\"Approved\" variant=\"success\" />\n<StatusBadge label=\"In Review\" variant=\"warning\" />\n<StatusBadge label=\"Rejected\" variant=\"error\" />",MODALS:"import { AppAlertModal, AppBottomSheet, ConfirmDialog } from '@/shared/modals';\n\n// 1. Alert Wrapper Modal (Custom content inside)\n<AppAlertModal\n  visible={isAlertOpen}\n  title=\"Loan Pre-Approval\"\n  onClose={() => setIsAlertOpen(false)}\n>\n  <YourCustomComponent />\n</AppAlertModal>\n\n// 2. Bottom Sheet Wrapper (Supports pull-down drag & blur backdrop)\n<AppBottomSheet\n  visible={isSheetOpen}\n  title=\"Repayment Schedule\"\n  draggable={true} // or configure globally via ThemeProvider\n  onClose={() => setIsSheetOpen(false)}\n>\n  <YourScheduleDetailsView />\n</AppBottomSheet>\n\n// 3. Image Confirmation Modal (ML-003, GL-06, GL-02 with Big/Small/Icon size)\n<ImageConfirmModal\n  visible={isOpen}\n  onClose={() => setIsOpen(false)}\n  imageType=\"big\" // 'big' (130px 3D illustration) | 'small' (64px) | 'icon' (44px)\n  preset=\"loan-doc\" // 'loan-doc' | 'wallet' | 'success' | 'warning' | 'logout'\n  title=\"Incomplete loan application\"\n  message=\"Your loan application is almost complete. Continue now so you don't miss the offer.\"\n  showDoNotShowAgain={true}\n  doNotShowAgainText=\"Do not show this notice again\"\n  confirmText=\"Continue\"\n  cancelText=\"Cancel\"\n  onConfirm={(doNotShowAgain) => {\n    console.log('Confirmed, doNotShowAgain:', doNotShowAgain);\n  }}\n/>\n\n// 4. Global Configuration (in ThemeProvider or updateTheme)\nupdateTheme({\n  modal: {\n    bottomSheetBackdropBlur: true,\n    bottomSheetDraggable: true,\n    alertBackdropBlur: true,\n  }\n});",LOAN_CALCULATOR:"import { LoanCalculator } from '@/core/utils';\n\n// 1. Calculate Monthly PMT Installment\nconst pmt = LoanCalculator.calculatePMT(10000, 12, 12); // P, Rate, Months\n\n// 2. Full Loan Simulation\nconst simulation = LoanCalculator.simulateLoan({\n  principal: 10000,\n  annualInterestRate: 12,\n  tenureMonths: 12,\n});\n// Returns: { monthlyPayment, totalInterest, totalPayment }\n\n// 3. Underwriting DSCR & DTI Ratios\nconst dscr = LoanCalculator.calculateDSCR(netIncome, monthlyDebt);\nconst dti = LoanCalculator.calculateDTI(monthlyDebt, grossIncome);",FORMAT_ID_UTILS:"import { ValidationFormatUtil, FormatUtil } from '@/core/utils';\n\n// 1. Bank Account Formatting & Masking\nconst formattedAcc = ValidationFormatUtil.formatAccountNumber('19034567890123'); // \"1903 4567 8901 23\"\nconst maskedAcc = ValidationFormatUtil.maskAccountNumber('19034567890123'); // \"190 •••• •••• 0123\"\nconst accValid = ValidationFormatUtil.validateAccountNumber('19034567890123'); // { isValid: true }\n\n// 2. Mobile Phone Number\nconst formattedPhone = ValidationFormatUtil.formatPhoneNumber('0912345678'); // \"0912 345 678\"\nconst maskedPhone = ValidationFormatUtil.maskPhoneNumber('0912345678'); // \"091 ••• •678\"\nconst phoneCheck = ValidationFormatUtil.validatePhoneNumber('0912345678'); // { isValid: true }\n\n// 3. Email Validation & Privacy Masking\nconst emailCheck = ValidationFormatUtil.validateEmail('user@domain.com'); // { isValid: true }\nconst maskedEmail = ValidationFormatUtil.maskEmail('nguyen.an@gmail.com'); // \"n•••••••n@gmail.com\"\n\n// 4. CCCD 12-Digit Decoder (Century, Gender, Year, Province)\nconst cccd = ValidationFormatUtil.validateCccdOrId('001098012345');\n// cccd.gender = 'MALE', cccd.birthYear = 1998, cccd.provinceCode = '001'\n\n// 5. Date & Time Validation with Business Hours Check\nconst dateCheck = ValidationFormatUtil.validateDate('29/02/2024'); // Valid leap year\nconst timeCheck = ValidationFormatUtil.validateTime('09:30'); // Valid 24h\nconst isBusiness = ValidationFormatUtil.isWithinBusinessHours('09:30', '08:00', '17:30'); // true",ORIGINATION_SERVICE:"import { LoanOriginationService } from '@/features/loan-origination/services/LoanOriginationService';\n\nconst service = LoanOriginationService.getInstance();\n\n// Create application\nconst app = await service.createApplication({\n  schemeCode: 'CASH',\n  requestedAmount: 5000,\n  tenureMonths: 12,\n  customerNric: '012345678901',\n  customerName: 'Sokha Chan',\n  currency: 'USD',\n});\n\n// Query all applications\nconst applications = await service.listApplications();",DATE_TIME_PICKERS:'import { DatePickerField, TimePickerField, DateRangePicker } from \'@/shared/components\';\n\n// 1. Single Day Picker (Alert Modal or Bottom Sheet)\n<DatePickerField\n  label="Date of Birth"\n  value={birthDate} // \'1995-06-15\'\n  presentation="bottomsheet" // or \'alert\'\n  selectionMode="day"\n  highlightSundays={true}\n  holidays={[\'2026-11-09\', \'2026-11-23\']}\n  onChangeDate={(dateStr) => setBirthDate(dateStr)}\n/>\n\n// 2. Week Scope Picker\n<DatePickerField\n  label="Repayment Week"\n  startDate={startOfWeek}\n  endDate={endOfWeek}\n  selectionMode="week"\n  presentation="bottomsheet"\n  onChangeRange={(start, end) => setWeekScope(start, end)}\n/>\n\n// 3. Time Picker (Alert Modal or Bottom Sheet)\n<TimePickerField\n  label="Appointment Time"\n  value={selectedTime} // \'09:30 AM\'\n  presentation="bottomsheet" // or \'alert\'\n  onChangeTime={(timeStr) => setSelectedTime(timeStr)}\n/>\n\n// 4. Date Range Picker (with ~ Separator and Clear Button)\n<DateRangePicker\n  label="Transaction Period"\n  startDate={startDate}\n  endDate={endDate}\n  presentation="bottomsheet"\n  onChangeStartDate={(start) => setStartDate(start)}\n  onChangeEndDate={(end) => setEndDate(end)}\n/>',ACCORDION_PROGRESS_EMPTY:'import { Accordion, ProgressBar, EmptyState } from \'@/shared/components\';\n\n// Expandable Collapsible Section\n<Accordion title="Loan Details & Amortization" subtitle="View monthly breakdown">\n  <Text>Monthly Breakdown Content...</Text>\n</Accordion>\n\n// Linear progress bar\n<ProgressBar progress={75} showLabel color="#E7252B" />\n\n// Empty state placeholder\n<EmptyState\n  icon="📂"\n  title="No Applications Found"\n  message="You have no drafts or submitted applications."\n  actionTitle="Create New Loan"\n  onAction={() => handleCreate()}\n/>',DOCUMENT_UPLOAD:'import { DocumentUploadBox, DocumentUploadGrid } from \'@mfe/ui-components\';\n\n// 1. Single Box Upload\n<DocumentUploadBox\n  label="National ID (Front Side)"\n  description="Take a clear photo of the front side of your ID card"\n  uploadedFileName={frontIdFile}\n  onUpload={() => launchCameraOrPicker()}\n  onRemove={() => setFrontIdFile(null)}\n/>\n\n// 2. DL_SL_10 Grid (Customer Document Upload)\n<DocumentUploadGrid\n  title="Upload documents"\n  onBackPress={() => handleBack()}\n  sections={documentSections}\n  onItemPress={(item) => handleUploadItem(item)}\n  onAddPress={() => handleAddOtherDocument()}\n/>',CUSTOMER_SERVICE:"import { CustomerService } from '@/features/customer/services/CustomerService';\n\nconst customerService = CustomerService.getInstance();\n\n// Query customer by National ID\nconst customer = await customerService.getCustomerByNric('012345678901');\nconsole.log('Customer CIF:', customer?.cifNumber, customer?.fullName);\n\n// Register and sync with CBS\nconst newCustomer = await customerService.registerCustomer({\n  nric: '098765432101',\n  fullName: 'Vannak Lim',\n  gender: 'M',\n  dateOfBirth: '1998-04-20',\n  phoneNumber: '092334455',\n  address: { province: 'Phnom Penh', district: 'Daun Penh', commune: 'Phsar Thmei' }\n});",DASHBOARD_SERVICE:"import { DashboardService } from '@/features/dashboard/services/DashboardService';\n\nconst dashboardService = DashboardService.getInstance();\nconst kpi = await dashboardService.getSalesKpi();\n\nconsole.log('Disbursed Amount:', kpi.totalDisbursedAmount);\nconsole.log('Target Achievement:', kpi.targetAchievementPercent + '%');",ENTERPRISE_COMPONENTS:"import {\n  ActionCard,\n  SelectChipGroup,\n  NumberStepper,\n  BottomSheetSelectField,\n  SummaryKeyValueList,\n  DataTable,\n} from '@/shared/components';\n\n// 1. Promotional / Action Card\n<ActionCard\n  title=\"Instant Cash Top-Up\"\n  description=\"Pre-approved credit line extension\"\n  icon=\"⚡\"\n  badge=\"Special Offer\"\n  onPress={() => handleAction()}\n/>\n\n// 2. Select Chip Group (Category and Filter Pills)\n<SelectChipGroup\n  items={[{ label: 'Cash', value: 'cash' }, { label: 'Auto', value: 'auto' }]}\n  selectedValue={selected}\n  onSelect={(v) => setSelected(v)}\n/>\n\n// 3. Number Stepper (Tenure, Installments)\n<NumberStepper\n  label=\"Loan Tenure\"\n  value={tenure}\n  min={6}\n  max={60}\n  step={6}\n  unit=\"Months\"\n  onChangeValue={(v) => setTenure(v)}\n/>\n\n// 4. BottomSheet Select Field\n<BottomSheetSelectField\n  label=\"Servicing Branch\"\n  options={[{ label: 'Phnom Penh Main', value: 'PP', subtitle: 'Monivong Blvd' }]}\n  selectedValue={branch}\n  onSelect={(v) => setBranch(v)}\n/>\n\n// 5. Summary Key-Value List\n<SummaryKeyValueList\n  title=\"Loan Breakdown\"\n  items={[\n    { key: 'p', label: 'Principal', value: '$10,000' },\n    { key: 'm', label: 'Monthly Payment', value: '$444.24', highlight: true }\n  ]}\n/>`,\n\n  DATA_TABLE: `// Horizontal Scrollable Data Table\n<DataTable\n  columns={[\n    { key: 'period', title: '#', width: 50 },\n    { key: 'dueDate', title: 'Due Date', width: 120 },\n    { key: 'pmt', title: 'Payment', width: 100, align: 'right' },\n  ]}\n  data={amortizationRows}\n  keyExtractor={(r) => r.period}\n/>",NAVIGATION_PROFILE_TIMELINE:"import {\n  CircleProfileAvatar,\n  EditProfileModal,\n  BottomNavigationBar,\n  ActionHeader,\n  AndroidSliverAppBar,\n  FloatingActionButton,\n  LoanTimeline,\n  MenuDrawer,\n} from '@/shared/components';\n\n// 1. Circle Profile Avatar & Edit Profile Modal\n<CircleProfileAvatar\n  name=\"Nguyễn Văn An\"\n  size={72}\n  showEditBadge={true}\n  onEditPress={() => setIsEditOpen(true)}\n/>\n<EditProfileModal\n  visible={isEditOpen}\n  onClose={() => setIsEditOpen(false)}\n  onSave={(data) => handleUpdateUser(data)}\n/>\n\n// 2. Bottom Navigation Bar with Badges\n<BottomNavigationBar\n  activeTab={tab}\n  onTabPress={(t) => setTab(t)}\n  tabs={[\n    { key: 'home', label: 'Home', icon: (c) => <HomeIcon color={c} /> },\n    { key: 'loans', label: 'Loans', icon: (c) => <LoanIcon color={c} />, badgeCount: 2 },\n  ]}\n/>\n\n// 3. Header with Actions & Android Sliver AppBar\n<ActionHeader\n  title=\"Loan Origination\"\n  leftAction={{ key: 'menu', icon: (c) => <MenuIcon color={c} />, onPress: () => openDrawer() }}\n  rightActions={[{ key: 'bell', icon: (c) => <BellIcon color={c} />, badgeCount: 3, onPress: () => {} }]}\n/>\n<AndroidSliverAppBar\n  title=\"Cash Loan Portfolio\"\n  subtitle=\"Available Credit: $25,000\"\n  expandedHeight={130}\n/>\n\n// 4. Floating Action Button (Circular or Extended)\n<FloatingActionButton\n  label=\"New Loan Application\"\n  extended={true} // or false for 56x56 circular FAB\n  onPress={() => handleCreateLoan()}\n/>\n\n// 5. Loan Underwriting Timeline\n<LoanTimeline\n  events={[\n    { id: '1', title: 'Submitted', date: '09:00 AM', status: 'completed' },\n    { id: '2', title: 'Underwriting', status: 'active', note: 'Officer reviewing DSCR' },\n    { id: '3', title: 'Disbursement', status: 'pending' },\n  ]}\n/>\n\n// 6. Sliding Menu Drawer\n<MenuDrawer\n  visible={isDrawerOpen}\n  userName=\"Nguyễn Văn An\"\n  onClose={() => setIsDrawerOpen(false)}\n  menuItems={[\n    { key: 'home', label: 'Dashboard', onPress: () => {} },\n    { key: 'loans', label: 'My Applications', badge: '2', onPress: () => {} },\n  ]}\n/>",BANKING_UTILS:"import {\n  DateTimeUtil,\n  DisburseUtil,\n  CollateralUtil,\n  LoanUnderwritingUtil,\n  EkycValidator,\n  DocumentUploadUtil,\n  SecurityAuthUtil,\n  AddressLocationUtil,\n  CurrencyWordsUtil,\n  TaxAndSalaryUtil,\n  CreditScoringCicUtil,\n  ContactSupportUtil,\n} from '@/core/utils';\n\n// 1. Loan Schedule & Age Check\nconst ageCheck = DateTimeUtil.isValidBorrowerAge('15/10/1998', 18, 60);\nconst dueDate = DateTimeUtil.calculateDueDate(new Date(), 1); // Auto-adjusts weekend/month-end\n\n// 2. Disbursement & Name Matching\nconst isMatch = DisburseUtil.isAccountHolderMatched('Nguyễn Văn An', 'NGUYEN VAN AN'); // true\nconst netPayout = DisburseUtil.calculateNetDisbursement({\n  approvedAmount: 50000000,\n  insuranceFee: 650000,\n  originationFee: 250000,\n  deductFeesFromDisbursement: true,\n});\n\n// 3. Loan Underwriting & DSCR\nconst dscr = LoanUnderwritingUtil.evaluateDscr(12000000, 4500000); // { pass: true, dscr: 2.67 }\nconst earlyPayoff = LoanUnderwritingUtil.calculateEarlyPayoffFee(30000000, 6);\n\n// 4. CIC Credit Scoring Overdue Debt Group\nconst cic = CreditScoringCicUtil.classifyOverdueDays(15); // { group: 'Group 2', riskTier: 'NEAR_PRIME' }\n\n// 5. Currency to Legal Words\nconst wordsVn = CurrencyWordsUtil.numberToVietnameseWords(50000000); // \"Năm mươi triệu đồng chẵn\"\n\n// 6. 7-Tier Progressive Personal Income Tax (PIT)\nconst pit = TaxAndSalaryUtil.calculateNetSalary(30000000, 1); // 1 dependent",DIGITAL_CHANNEL_COMPONENTS:"import {\n  RepaymentScheduleTable,\n  OtpVerificationWithTimer,\n  CameraOverlayGuide,\n  PromoBannerCarousel,\n  UpsellOfferModal,\n  ContactSupportModal,\n  AppTabs,\n  NetworkImage,\n  MapBranchView,\n} from '@/shared/components';\n\n// 1. Repayment Amortization Table\n<RepaymentScheduleTable\n  principal={50000000}\n  annualInterestRate={18}\n  tenureMonths={12}\n  disbursementDate={new Date()}\n/>\n\n// 2. 3-Minute OTP Verification with Countdown\n<OtpVerificationWithTimer\n  length={6}\n  phoneNumber=\"0912 345 678\"\n  onOtpComplete={(otp) => handleVerifyOtp(otp)}\n  onResendOtp={() => handleResendOtp()}\n/>\n\n// 3. VisionCamera Cutout Overlay Guide (ID Card & Face Oval)\n<CameraOverlayGuide\n  mode=\"ID_CARD_FRONT\" // 'ID_CARD_FRONT' | 'ID_CARD_BACK' | 'PORTRAIT_FACE'\n  title=\"Scan Citizen ID Card\"\n  instruction=\"Align front of CCCD inside frame\"\n/>\n\n// 4. Promo Banners Carousel\n<PromoBannerCarousel\n  banners={bannersList}\n  onBannerPress={(b) => handleBannerClick(b)}\n/>\n\n// 5. Pre-Approved Top-up Upsell Modal (ML-004)\n<UpsellOfferModal\n  visible={isOfferOpen}\n  offerLimit={500000000}\n  interestRateMonthly={1.5}\n  onAccept={() => handleApplyTopUp()}\n  onDismiss={() => setIsOfferOpen(false)}\n/>\n\n// 6. AppTabs Tab Bar & Content Switcher\n<AppTabs\n  variant=\"underline\"\n  tabs={[\n    { key: 'schemes', label: 'Loan Schemes', badgeCount: 3, content: <SchemesView /> },\n    { key: 'history', label: 'History', content: <HistoryView /> },\n  ]}\n/>\n\n// 7. Resilient Network Image with Skeleton & Retry\n<NetworkImage\n  uri=\"https://domain.com/photo.jpg\"\n  style={{ width: 140, height: 100 }}\n  borderRadius={8}\n  altText=\"Document preview\"\n/>\n\n// 8. Branch Map Locator & Directions\n<MapBranchView\n  locations={branchList}\n  onSelectLocation={(loc) => handleSelectBranch(loc)}\n/>",BIZMOB_DEVICE_MEDIA:"import {\n  getDeviceInfo,\n  openCamera,\n  openCameraIDCard,\n  openDocumentCamera,\n  openLocationCamera,\n  openMyLibrary,\n  saveImageBase64,\n  downloadImage,\n} from 'react-native-bizmob-plugin';\n\n// 1. Device Hardware Info\nconst info = await getDeviceInfo();\n\n// 2. Viewfinder & ID Card Camera\nconst photo = await openCamera({ quality: 80 });\nconst idCard = await openCameraIDCard();\n\n// 3. Multi-Document Camera with Compose & SwiftUI\nconst docs = await openDocumentCamera({ max_count: 5 });\n\n// 4. GPS Geotagged Location Camera\nconst loc = await openLocationCamera({ quality: 80 });\n\n// 5. My Library & File Storage\nconst library = await openMyLibrary({ title: 'Loan Documents' });\nawait saveImageBase64({ image_base_64: '...', file_name: 'doc.png' });\nawait downloadImage({ url: 'https://...', file_name: 'remote.jpg' });",BIZMOB_SECURITY:"import {\n  executeBiometric,\n  issueToken,\n  newToken,\n  disableScreenshot,\n  enableScreenshot,\n  registerScreenshotListener,\n  unregisterScreenshotListener,\n  addScreenshotListener,\n} from 'react-native-bizmob-plugin';\n\n// 1. Biometric Authentication & Hardware Check\nconst canBio = await executeBiometric({ type: 'available' });\nconst authRes = await executeBiometric({\n  type: 'auth',\n  title: 'Identity Verification',\n  subTitle: 'Confirm loan disbursement',\n});\n\n// 2. Token Issuance & Refresh\nconst token = await issueToken({ deviceId: 'DEV_9988' });\nconst refreshed = await newToken({ accessToken, refreshToken });\n\n// 3. Screen Capture & Recording Shield (FLAG_SECURE)\nawait disableScreenshot(); // Screen recording blocked\nawait enableScreenshot();  // Unblocked\n\n// 4. Screenshot Detection Listener\nconst sub = addScreenshotListener((event) => {\n  console.log('User captured screenshot!', event);\n});",BIZMOB_NETWORK:"import {\n  requestTrCode,\n  requestHttp,\n  openInAppBrowser,\n  playHaptic,\n  downloadOTA,\n  shareSNS,\n  hideSplashScreen,\n} from 'react-native-bizmob-plugin';\n\n// 1. Core Banking TR Code Transaction\nconst trRes = await requestTrCode({\n  url: 'https://kh-mcnc-001.mcnc.com.kh/los-app/api/USC00000I02',\n  method: 'POST',\n  header: { serviceId: 'USC00000I02', channelTypeCode: 'LOS_MOBILE' },\n  payload: { cifNumber: 'CIF998811' },\n});\n\n// 2. Standard REST HTTP Client\nconst httpRes = await requestHttp({\n  url: 'https://api.github.com',\n  method: 'GET',\n});\n\n// 3. In-App Browser modal with navigation\nawait openInAppBrowser({ url: 'https://mcnc.co.kr', title: 'Portal' });\n\n// 4. Sensory Haptic Feedback (Sound + Vibrate)\nawait playHaptic({ type: 2, vibrate_repeat: 2 });\n\n// 5. OTA Zip Update & Splash Hide\nawait downloadOTA({ url: 'https://ota.domain.com/patch.zip', is_zip: true });\nawait hideSplashScreen({ duration: 300 });",BIZMOB_CORE:"import {\n  multiply,\n  execute,\n  callPlugin,\n  sampleActivity,\n  samplePermission,\n  sampleLifecycle,\n  sampleEvent,\n  sampleDeepLink,\n  startBackgroundNativeView,\n} from 'react-native-bizmob-plugin';\n\n// 1. Low-Level TurboModule C++ Bridge\nconst result = multiply(7, 6); // 42\n\n// 2. Universal Generic Plugin Dispatcher\nconst custom = await callPlugin({\n  pluginId: 'CAMERA',\n  params: { quality: 80 },\n});\nconst raw = await execute('GET_DEVICE_INFO');\n\n// 3. Native Lifecycle & Sample Actions\nawait sampleActivity({ action: 'OPEN_SAMPLE' });\nawait samplePermission({ permissions: ['android.permission.CAMERA'] });\nawait sampleLifecycle();\nawait sampleEvent({ event_name: 'TEST_EVENT', steps: 1 });\nawait startBackgroundNativeView({ command: 'START_CAMERA_BACKGROUND' });"}},5655:function(e,t,r){Object.defineProperty(t,"__esModule",{value:!0}),Object.defineProperty(t,"ShowcaseNavigator",{enumerable:!0,get:function(){return i.ShowcaseNavigator}});var n=r(22261),i=r(82206);n._(r(58474),t),n._(r(68192),t),n._(r(76368),t),n._(r(84432),t)},71861:function(e,t,r){Object.defineProperty(t,"__esModule",{value:!0}),Object.defineProperty(t,"ContractModel",{enumerable:!0,get:function(){return o}});var n=r(45222),i=r(90569),o=function(){"use strict";function e(){n