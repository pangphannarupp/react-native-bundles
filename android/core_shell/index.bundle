,"loadError":"이용약관을 불러오지 못했습니다.","termsContent":"본 일반 이용약관(이하 \\"약관\\")은 [마이크로파이낸스 기관 Plc.](이하 \\"기관\\")이 제공하는 금융 상품 및 서비스의 이용에 적용됩니다. 본 약관은 모든 고객(이하 \\"고객\\")이 기관의 금융 상품이나 서비스를 신청하거나 이용하기 전에 권리와 의무를 명확히 이해할 수 있도록 제공됩니다.\\n\\n고객이 서비스 신청서에 서명하거나 별도의 신청서 없이 서비스를 이용하는 경우, 본 약관 및 해당 서비스에 적용되는 추가 조건을 읽고 이해하였으며 이에 동의한 것으로 간주됩니다.\\n\\n모든 개인정보, 금융 거래 기록 및 신분 확인 문서는 캄보디아 관련 개인정보 보호 규정 및 캄보디아 국립은행(NBC)의 규정을 엄격히 준수하여 안전하게 보관됩니다."}},"auth":{"login":{"title":"다시 오신 것을 환영합니다","subtitle":"LOS 대시보드에 접속하려면 로그인해 주세요.","companyId":"회사 코드","companyIdPlaceholder":"회사 코드를 입력하세요","userId":"사용자 ID","userIdPlaceholder":"사용자 ID 또는 이메일을 입력하세요","password":"비밀번호","passwordPlaceholder":"비밀번호를 입력하세요","forgotPassword":"비밀번호를 잊으셨나요?","signInButton":"로그인","validationCompanyRequired":"회사 코드를 입력해 주세요","validationUserRequired":"사용자 ID를 입력해 주세요","validationPasswordRequired":"비밀번호는 최소 6자 이상이어야 합니다"},"otp":{"title":"OTP 인증","subtitle":"등록된 휴대폰 번호 또는 이메일로 전송된 6자리 번호를 입력해 주세요.","resendCode":"인증번호 재전송","resendIn":"재전송 가능 시간:","verifyButton":"인증 및 계속","invalidCode":"올바른 6자리 인증번호를 입력해 주세요."},"biometric":{"title":"생체 인증 등록","subtitle":"빠르고 안전한 생체 인증 활성화","description":"지문 또는 얼굴 인식을 사용하여 매번 비밀번호를 입력할 필요 없이 간편하게 로그인하세요.","enableButton":"생체 인증 사용","skipButton":"다음에 하기","successMessage":"생체 인증이 성공적으로 설정되었습니다."}}}')},32527:function(e){"use strict";e.exports=JSON.parse('{"common":{"back":"返回","next":"下一步","cancel":"取消","confirm":"确认","skip":"跳过","processing":"处理中...","error":"发生错误","success":"成功","agree":"我同意","exit":"退出","exitAppTitle":"退出应用","exitAppMessage":"您确定要退出应用程序吗？"},"launch":{"splash":{"version":"版本","checkingUpdates":"正在检查更新...","downloadingUpdates":"正在下载更新...","upToDate":"已是最新版本"},"language":{"welcomeTo":"欢迎使用","appName":"信贷发起审批系统 (LOS)","selectLanguagePrompt":"请选择您的语言","selectedNotice":"已选择：","changeLaterTip":"您稍后可以在系统设置中随时更改语言。"},"terms":{"title":"条款与条件","sectionIntro":"I. 简介","introTitle":"I. 简介","agreeCheckboxLabel":"同意所有条款与条件","agreeButton":"我同意","validationError":"请先同意条款与条件以继续。","loadError":"无法加载条款与条件。","termsContent":"本通用条款与条件（以下简称“条款”）适用于使用[小额信贷机构股份有限公司]（以下简称“本机构”）提供的产品和服务。提供这些条款旨在帮助所有客户（“客户”）在申请或使用本机构的任何产品或服务之前充分了解其权利和义务。\\n\\n客户签署任何产品或服务申请表，或在没有申请表的情况下使用服务，即视为客户已阅读、理解并接受本条款以及适用于各项产品或服务的任何补充具体条款。\\n\\n所有个人数据、交易记录和身份证明文件均严格按照柬埔寨现行数据保护法规和柬埔寨国家银行的规定妥善存储和保密。"}},"auth":{"login":{"title":"欢迎回来","subtitle":"请输入您的凭据以访问 LOS 控制面板。","companyId":"公司代码","companyIdPlaceholder":"请输入公司代码","userId":"用户 ID / 邮箱","userIdPlaceholder":"请输入用户 ID 或邮箱","password":"密码","passwordPlaceholder":"请输入密码","forgotPassword":"忘记密码？","signInButton":"登录","validationCompanyRequired":"公司代码不能为空","validationUserRequired":"用户 ID 不能为空","validationPasswordRequired":"密码长度至少需为 6 个字符"},"otp":{"title":"OTP 验证码","subtitle":"请输入发送至您预留手机或电子邮箱的 6 位数字验证码。","resendCode":"重新发送验证码","resendIn":"重新发送倒计时：","verifyButton":"验证并继续","invalidCode":"请输入有效的 6 位验证码。"},"biometric":{"title":"生物识别认证注册","subtitle":"开启快速安全的生物识别访问","description":"使用指纹或面部识别即时登录，无需每次重复输入密码。","enableButton":"启用生物识别","skipButton":"暂不设置","successMessage":"生物识别设置成功。"}}}')},25984:function(e){"use strict";e.exports=JSON.parse('{"name":"@mfe/remote-customer","version":"1.0.0","private":true,"main":"index.ts","types":"index.ts","dependencies":{"react":"19.3.0","react-native":"0.88.0","@mfe/core":"workspace:*","@mfe/theme":"workspace:*","@mfe/ui-components":"workspace:*"}}')},49938:function(e){"use strict";e.exports=JSON.parse('{"name":"@mfe/remote-dashboard","version":"1.0.12","private":true,"main":"src/index.ts","types":"src/index.ts","dependencies":{"react":"19.3.0","react-native":"0.88.0","@mfe/core":"workspace:*","@mfe/theme":"workspace:*","@mfe/ui-components":"workspace:*"}}')},33082:function(e){"use strict";e.exports=JSON.parse('{"name":"@mfe/remote-launch-auth","version":"1.0.6","private":true,"main":"index.ts","types":"index.ts","dependencies":{"react":"19.3.0","react-native":"0.88.0","@mfe/core":"workspace:*","@mfe/theme":"workspace:*","@mfe/ui-components":"workspace:*"}}')},36416:function(e){"use strict";e.exports=JSON.parse('{"name":"@mfe/remot