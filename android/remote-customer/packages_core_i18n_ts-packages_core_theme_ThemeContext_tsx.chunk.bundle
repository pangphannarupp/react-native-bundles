ce Institution Plc.] (the “Institution”). They are provided to help all clients (the “Client”) understand their rights and obligations before applying for or using any of the Institution’s products or services.\\n\\nBy signing any application form for the Institution’s products or services, or by providing instructions or using the services without an application form, the Client is deemed to have read, understood, and accepted these Terms, as well as any additional specific terms and conditions applicable to each product or service.\\n\\nAll personal data, transaction records, and identity documents are stored in strict compliance with the applicable data protection regulations of Cambodia and the National Bank of Cambodia."}},"auth":{"login":{"title":"Welcome Back","subtitle":"Please sign in with your credentials to access your LOS dashboard.","companyId":"Company ID","companyIdPlaceholder":"Enter Company ID","userId":"User ID","userIdPlaceholder":"Enter User ID or Email","password":"Password","passwordPlaceholder":"Enter your password","forgotPassword":"Forgot password?","signInButton":"Sign In","validationCompanyRequired":"Company ID is required","validationUserRequired":"User ID is required","validationPasswordRequired":"Password must be at least 6 characters"},"otp":{"title":"OTP Verification","subtitle":"Enter the 6-digit code sent to your registered phone or email.","resendCode":"Resend Code","resendIn":"Resend in","verifyButton":"Verify & Proceed","invalidCode":"Please enter a valid 6-digit verification code."},"biometric":{"title":"Bio Authentication Register","subtitle":"Enable quick and secure biometric access","description":"Use fingerprint or face recognition to sign in instantly without entering your password every time.","enableButton":"Enable Biometrics","skipButton":"Skip for Now","successMessage":"Biometrics configured successfully."}}}')},14410:function(e){"use strict";e.exports=JSON.parse('{"common":{"back":"ត្រឡប់ក្រោយ","next":"បន្ទាប់","cancel":"បោះបង់","confirm":"បញ្ជាក់","skip":"រំលង","processing":"កំពុងដំណើរការ...","error":"មានបញ្ហាកើតឡើង","success":"ជោគជ័យ","agree":"ខ្ញុំយល់ព្រម","exit":"ចាកចេញ","exitAppTitle":"ចាកចេញពីកម្មវិធី","exitAppMessage":"តើអ្នកពិតជាចង់ចាកចេញពីកម្មវិធីនេះមែនទេ?"},"launch":{"splash":{"version":"កំណែទម្រង់","checkingUpdates":"កំពុងពិនិត្យមើលបច្ចុប្បន្នភាព...","downloadingUpdates":"កំពុងទាញយកបច្ចុប្បន្នភាព...","upToDate":"ទាន់សម័យ"},"language":{"welcomeTo":"សូមស្វាគមន៍មកកាន់","appName":"ប្រព័ន្ធស្នើសុំឥណទាន (LOS)","selectLanguagePrompt":"សូមជ្រើសរើសភាសារបស់អ្នក","selectedNotice":"បានជ្រើសរើស៖","changeLaterTip":"អ្នកអាចផ្លាស់ប្តូរភាសាបានគ្រប់ពេលនៅក្នុងការកំណត់។"},"terms":{"title":"លក្ខខណ្ឌ និងកិច្ចព្រមព្រៀង","sectionIntro":"I. សេចក្តីផ្តើម","introTitle":"I. សេចក្តីផ្តើម","agreeCheckboxLabel":"យល់ព្រមលើលក្ខខណ្ឌទាំងអស់","agreeButton":"ខ្ញុំយល់ព្រម","validationError":"សូមយល់ព្រមលើលក្ខខណ្ឌ និងកិច្ចព្រមព្រៀងដើម្បីបន្ត។","loadError":"មិនអាចទាញយកលក្ខខណ្ឌបានទេ។","termsContent":"លក្ខខណ្ឌទូទៅទាំងនេះ (ហៅកាត់ថា \\"លក្ខខណ្ឌ\\") គ្រប់គ្រងលើការប្រើប្រាស់ផលិតផល និងសេវាកម្មដែលផ្តល់ដោយ [គ្រឹះស្ថានមីក្រូហិរញ្ញវត្ថុ ភីអិលស៊ី] (ហៅកាត់ថា \\"គ្រឹះស្ថាន\\")។ លក្ខខណ្ឌទាំងនេះត្រូវបានផ្តល់ជូនដើម្បីជួយអតិថិជនទាំងអស់ (\\"អតិថិជន\\") យល់ច្បាស់ពីសិទ្ធិ និងកាតព្វកិច្ចរបស់ពួកគេ មុនពេលដាក់ពាក្យស្នើសុំ ឬប្រើប្រាស់ផលិតផល ឬសេវាកម្មណាមួយរបស់គ្រឹះស្ថាន។\\n\\nតាមរយៈការចុះហត្ថលេខាលើទម្រង់ពាក្យសុំ ឬការប្រើប្រាស់សេវាកម្មដោយគ្មានទម្រង់ពាក្យសុំ អតិថិជនត្រូវបានចាត់ទុកថាបានអាន យល់ និងទទួលយកលក្ខខណ្ឌទាំងនេះ ព្រមទាំងលក្ខខណ្ឌជាក់លាក់បន្ថែមដែលអាចអនុវត្តចំពោះផលិតផល ឬសេវាកម្មនីមួយៗ។\\n\\nទិន្នន័យផ្ទាល់ខ្លួន កំណត់ត្រាប្រតិបត្តិការ និងឯកសារអត្តសញ្ញាណទាំងអស់ត្រូវបានរក្សាទុកដោយអនុលោមតាមបទប្បញ្ញត្តិស្តីពីការការពារទិន្នន័យនៃព្រះរាជាណាចក្រកម្ពុជា និងធនាគារជាតិនៃកម្ពុជា។"}},"auth":{"login":{"title":"សូមស្វាគមន៍មកវិញ","subtitle":"សូមចូលប្រើប្រាស់គណនីរបស់អ្នកដើម្បីចូលទៅកាន់ប្រព័ន្ធ LOS។","companyId":"លេខកូដក្រុមហ៊ុន","companyIdPlaceholder":"បញ្ចូលលេខកូដក្រុមហ៊ុន","userId":"ឈ្មោះគណនី ឬ អ៊ីមែល","userIdPlaceholder":"បញ្ចូលឈ្មោះគណនី ឬ អ៊ីមែល","pa